{
  "name": "rov-analytics",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @rov/web dev",
    "build": "bun --filter @rov/web build",
    "typecheck": "bun --filter '*' typecheck",
    "backend:dev": "bun --filter @rov/backend dev",
    "backend:deploy": "bun --filter @rov/backend deploy"
  }
}
